rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public-read cover images. Writes happen only via the Admin SDK in the API.
    match /course-covers/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    // Default-deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
