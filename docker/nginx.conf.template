# Rendered by the nginx image's envsubst at start; only LEARNWREN_* names are
# substituted (NGINX_ENVSUBST_FILTER), nginx variables like $uri are untouched.
# Mirrors the Firebase Hosting config in firebase.deploy.json: SPA fallback,
# /api proxy, immutable hashed assets, no-store index.html, security headers.

map $uri $lw_cache_control {
    # Empty = header not added: the api sets its own Cache-Control on /api.
    ~^/api/ "";
    default "no-cache, no-store, must-revalidate";
    ~*\.(js|css|woff2?|ttf|eot|ico|png|svg|webp|gif|jpe?g|avif|webmanifest)$ "public, max-age=31536000, immutable";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Uploads pass through the api: 8 MB video chunks, materials up to 50 MB,
    # cover images up to 10 MB.
    client_max_body_size 64m;

    add_header Cache-Control $lw_cache_control always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Same policy as production hosting minus the Google storage origins:
    # every file (uploads, downloads, segments, public images) is served by /api here.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:" always;

    # Resolve the api per request through Docker's DNS: a literal upstream is
    # resolved once at nginx start, so recreating only the api (a new IP)
    # would leave web proxying to the old address (502) until web restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:3333;

    location /api/ {
        # No URI part, as before: the original request URI (/api/...) is
        # passed unchanged.
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        # Stream upload bodies straight through instead of spooling to disk.
        proxy_request_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
