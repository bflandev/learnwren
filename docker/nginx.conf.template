# Rendered by the nginx image's envsubst at start; only LEARNWREN_* names are
# substituted (NGINX_ENVSUBST_FILTER), nginx variables like $uri are untouched.
# Mirrors the Firebase Hosting config in firebase.deploy.json: SPA fallback,
# /api proxy, immutable hashed assets, no-store index.html, security headers.

map $uri $lw_cache_control {
    # Empty = header not added: the api sets its own Cache-Control on /api.
    ~^/api/ "";
    default "no-cache, no-store, must-revalidate";
    ~*\.(js|css|woff2?|ttf|eot|ico|png|svg|webp|gif|jpe?g|avif|webmanifest)$ "public, max-age=31536000, immutable";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Lesson materials (<= 50 MB) pass through the api in fake-storage mode.
    client_max_body_size 64m;

    add_header Cache-Control $lw_cache_control always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Same policy as production hosting, with the Storage emulator origin in
    # place of storage.googleapis.com (video uploads go there directly).
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: ${LEARNWREN_STORAGE_ORIGIN}; connect-src 'self' ${LEARNWREN_STORAGE_ORIGIN}; media-src 'self' blob: ${LEARNWREN_STORAGE_ORIGIN}; worker-src 'self' blob:" always;

    location /api/ {
        # The api shares the emulators service's network namespace.
        proxy_pass http://emulators:3333;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
