{
  "name": "api-video",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api-video/src",
  "projectType": "library",
  "tags": ["scope:api"],
  "// targets": "to see all targets run: nx show project api-video --web",
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/api-video/**/*.ts"]
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api-video",
        "tsConfig": "libs/api-video/tsconfig.lib.json",
        "packageJson": "libs/api-video/package.json",
        "main": "libs/api-video/src/index.ts",
        "assets": ["libs/api-video/*.md"]
      }
    }
  }
}
