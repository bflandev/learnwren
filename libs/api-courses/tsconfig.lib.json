{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "composite": true,
    "declaration": true,
    "types": ["node", "multer"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "../api-object-storage/tsconfig.lib.json"
    },
    {
      "path": "../api-document-store/tsconfig.lib.json"
    },
    {
      "path": "../api-http-errors/tsconfig.lib.json"
    },
    {
      "path": "../api-firebase/tsconfig.lib.json"
    },
    {
      "path": "../api-auth/tsconfig.lib.json"
    },
    {
      "path": "../shared-data-models/tsconfig.lib.json"
    }
  ]
}
