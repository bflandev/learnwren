{
  "name": "web-video",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web-video/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:web"],
  "targets": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "options": {
        "cwd": "libs/web-video",
        "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/out-tsc/libs/web-video/**/*.{d.ts,d.cts,d.mts}",
        "{workspaceRoot}/libs/web-video/tsconfig.lib.tsbuildinfo"
      ]
    },
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/web-video/ng-package.json",
        "tsConfig": "libs/web-video/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/web-video/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
