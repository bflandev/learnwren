# Nx cache and installation — do not commit
.nx/
.claude/worktrees
.claude/settings.local.json
.claude/*.local.md
.worktrees/

# macOS
.DS_Store

# Dependencies
node_modules/

# Build outputs
dist/
.angular
*.tsbuildinfo

# Test coverage artifacts (regenerate via `pnpm crap:coverage`)
coverage/

# Stryker mutation testing scratch + reports (regenerate via `pnpm mutate`)
.stryker-tmp/
reports/mutation/

vite.config.*.timestamp*
__screenshots__/

vitest.config.*.timestamp*

# Firebase emulator debug logs (emitted on each `pnpm emulators` run)
firestore-debug.log
firebase-debug.log

# Firebase CLI deploy cache (emitted by `firebase deploy`)
.firebase/

# Rendered secrets — never commit. .env.tpl / .env.deploy.tpl are the sources of truth.
.env
.env.learn-wren

# Playwright MCP verification artifacts (screenshots / snapshots)
.playwright-mcp/