# Nx cache and installation — do not commit
.nx/
.claude/worktrees
.claude/settings.local.json
.claude/*.local.md
.worktrees/

# macOS
.DS_Store

# Dependencies
node_modules/

# Build outputs
dist/
.angular
*.tsbuildinfo

# Test coverage artifacts (regenerate via `pnpm crap:coverage`)
coverage/

# Stryker mutation testing scratch + reports (regenerate via `pnpm mutate`)
.stryker-tmp/
reports/mutation/

vite.config.*.timestamp*
__screenshots__/

vitest.config.*.timestamp*

# Firebase emulator debug logs (emitted on each `pnpm emulators` run)
firestore-debug.log
firebase-debug.log

# Rendered secrets — never commit. .env.tpl is the source of truth.
.env

# Generated by tools/web/build-environment.ts; produced on every nx run for web.
apps/web/src/environments/environment.ts