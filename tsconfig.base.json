{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@learnwren/shared-data-models": [
        "./libs/shared-data-models/src/index.ts"
      ],
      "@learnwren/api-firebase": ["./libs/api-firebase/src/index.ts"],
      "@learnwren/api-auth": ["./libs/api-auth/src/index.ts"],
      "@learnwren/web-auth": ["./libs/web-auth/src/index.ts"],
      "@learnwren/api-courses": ["./libs/api-courses/src/index.ts"],
      "@learnwren/web-courses": ["./libs/web-courses/src/index.ts"],
      "@learnwren/web-video": ["./libs/web-video/src/index.ts"],
      "@learnwren/web-ui": ["./libs/web-ui/src/index.ts"],
      "@learnwren/web-catalog": ["./libs/web-catalog/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
