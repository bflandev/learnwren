# Learn Wren self-hosting settings — read by docker-compose.yml.
#   cp .env.example .env && docker compose up -d
# Every value has a default that works on a single machine, so an empty .env
# is valid. Developers running `pnpm start` use .env.tpl (1Password) instead.

# Hostname browsers use to reach this instance. It needs to resolve only from
# the browser (the api builds links on it but never fetches them). Keep
# `localhost` for a same-machine install.
LEARNWREN_HOST=localhost

# Port the web app listens on. The app is at http://LEARNWREN_HOST:LEARNWREN_WEB_PORT
LEARNWREN_WEB_PORT=8000

# The origin browsers use, no trailing slash. Emailed links, CORS and image
# URLs are built on it. Defaults to http://LEARNWREN_HOST:LEARNWREN_WEB_PORT;
# set it when a TLS reverse proxy fronts the stack, or reset links go out as
# plain HTTP.
# LEARNWREN_PUBLIC_URL=https://learn.example.com

# Host address the web port listens on. 0.0.0.0 (default) = every interface.
# Set 127.0.0.1 for the first run, until you have registered the bootstrap
# admin, so nobody else can register that address first.
LEARNWREN_WEB_BIND=0.0.0.0

# Password for the bundled Postgres (the data store). The default is insecure:
# change it before the first `docker compose up`. Postgres stores it in its
# volume on first start, so changing it later also needs
# `ALTER USER postgres PASSWORD ...` inside the db. Use letters, digits, '-' and
# '_' only: it is embedded in a URL. The database is never published to the host.
# Upgrading from an emulator-based install? Data is not migrated; see the
# header of docker-compose.yml (start with `docker compose up -d --remove-orphans`).
LEARNWREN_POSTGRES_PASSWORD=learnwren-change-me

# Outgoing email: verification, password-reset, email-change and unlock links,
# plus new-module notifications. `console` logs each message (with its link) to
# `docker compose logs api` instead of sending it.
LEARNWREN_EMAIL_TRANSPORT=console
LEARNWREN_EMAIL_FROM=noreply@learnwren.local
# Required when LEARNWREN_EMAIL_TRANSPORT=smtp:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Object store credentials (RustFS root user, S3-compatible). Change the secret
# before exposing the stack to anyone else; the store is never published to the
# host and the api creates its buckets on boot.
LEARNWREN_S3_ACCESS_KEY=learnwren
LEARNWREN_S3_SECRET_KEY=learnwren-change-me

# Video transcoding is pinned to `ffmpeg` in docker-compose.yml (real, in-process
# AES-128 HLS) and all files live in the object store. Nothing else to configure.

# Optional storage quota (GB) for the admin health dashboard's alert and bar.
# LEARNWREN_STORAGE_QUOTA_GB=

# The data store (Postgres) and identity (built-in accounts) are pinned in
# docker-compose.yml; the api creates its one table on boot.

# First admin for a new self-hosted install: this account becomes ADMIN when it
# logs in after verifying its email. Clear it once you have an admin.
# LEARNWREN_BOOTSTRAP_ADMIN_EMAIL=you@example.com
