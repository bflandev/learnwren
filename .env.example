# Learn Wren self-hosting settings — read by docker-compose.yml.
#   cp .env.example .env && docker compose up -d
# Every value has a default that works on a single machine, so an empty .env
# is valid. Developers running `pnpm start` use .env.tpl (1Password) instead.

# Hostname browsers use to reach this instance. It must resolve to this
# machine from the browser AND from inside the containers (the api mints
# upload URLs on it). Keep `localhost` for a same-machine install.
LEARNWREN_HOST=localhost

# Port the web app listens on. The app is at http://LEARNWREN_HOST:LEARNWREN_WEB_PORT
LEARNWREN_WEB_PORT=8000

# Address the Emulator UI (4000), Firestore (8080) and Auth (9099) ports bind
# to. These have no authentication at all; leave them on loopback.
LEARNWREN_ADMIN_BIND=127.0.0.1

# Outgoing email for account unlock and new-module notifications.
# `console` logs the message to `docker compose logs api` instead of sending.
# Verification and password-reset links come from the Auth emulator and are
# read from the Emulator UI (http://127.0.0.1:4000/auth) regardless of this setting.
LEARNWREN_EMAIL_TRANSPORT=console
LEARNWREN_EMAIL_FROM=noreply@learnwren.local
# Required when LEARNWREN_EMAIL_TRANSPORT=smtp:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Object store credentials (RustFS root user, S3-compatible). Change the secret
# before exposing the stack to anyone else; the store is never published to the
# host and the api creates its buckets on boot.
LEARNWREN_S3_ACCESS_KEY=learnwren
LEARNWREN_S3_SECRET_KEY=learnwren-change-me

# Video transcoding is pinned to `ffmpeg` in docker-compose.yml (real, in-process
# AES-128 HLS) and all files live in the object store. Nothing else to configure.

# Optional storage quota (GB) for the admin health dashboard's alert and bar.
# LEARNWREN_STORAGE_QUOTA_GB=

# Data store (US-09-04 Slice D2). firestore (default: Firestore, or its
# emulator in local dev) or postgres (self-hosted; needs LEARNWREN_POSTGRES_URL).
# The api creates its one table on boot.
# LEARNWREN_DATA_STORE=firestore
# LEARNWREN_POSTGRES_URL=postgres://learnwren:change-me@postgres:5432/learnwren

# Identity (US-09-04 Slice D3b). firebase (default: Firebase Authentication,
# or its emulator in local dev) or local (self-hosted accounts, sessions and
# email links in the data store; requires LEARNWREN_DATA_STORE=postgres).
# LEARNWREN_IDENTITY=firebase

# First admin for a new self-hosted install: this account becomes ADMIN when it
# logs in after verifying its email. Clear it once you have an admin.
# LEARNWREN_BOOTSTRAP_ADMIN_EMAIL=you@example.com
